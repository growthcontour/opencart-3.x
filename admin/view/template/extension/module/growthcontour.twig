{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="gc-save" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div id="gc-alert"></div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-growthcontour" class="form-horizontal">

          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ tab_settings }}</a></li>
            <li><a href="#tab-orders" data-toggle="tab"><i class="fa fa-shopping-cart"></i> {{ tab_orders }}</a></li>
            <li><a href="#tab-cart" data-toggle="tab"><i class="fa fa-shopping-basket"></i> {{ tab_cart }}</a></li>
            <li><a href="#tab-catalog" data-toggle="tab"><i class="fa fa-cubes"></i> {{ tab_catalog }}</a></li>
            <li><a href="#tab-import" data-toggle="tab"><i class="fa fa-download"></i> {{ tab_import }}</a></li>
            <li><a href="#tab-delivery" data-toggle="tab"><i class="fa fa-truck"></i> {{ tab_delivery }}</a></li>
            <li><a href="#tab-logs" data-toggle="tab"><i class="fa fa-list-alt"></i> {{ tab_logs }}</a></li>
            <li><a href="#tab-support" data-toggle="tab"><i class="fa fa-life-ring"></i> {{ tab_support }}</a></li>
          </ul>

          <div class="tab-content">

            <!-- Tab: Settings -->
            <div class="tab-pane active" id="tab-settings">

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_status" id="input-status" class="form-control">
                    <option value="1" {{ module_growthcontour_status ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_status ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-domain">{{ entry_domain }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_growthcontour_domain" value="{{ module_growthcontour_domain }}" placeholder="{{ placeholder_domain }}" id="input-domain" class="form-control" />
                  <p class="help-block">{{ help_domain }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-token">{{ entry_token }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_growthcontour_token" value="{{ module_growthcontour_token }}" id="input-token" class="form-control" />
                  <p class="help-block">{{ help_token }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-integration">{{ entry_integration }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_growthcontour_integration_id" value="{{ module_growthcontour_integration_id }}" placeholder="{{ placeholder_integration }}" id="input-integration" class="form-control" />
                  <p class="help-block">{{ help_integration }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_check_connection }}</label>
                <div class="col-sm-10">
                  <button type="button" id="btn-check-connection" class="btn btn-info"><i class="fa fa-plug"></i> {{ button_check_connection }}</button>
                  <div id="check-connection-result" style="margin-top:10px;"></div>
                  <p class="help-block">{{ help_check_connection }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-inbound-token">{{ entry_inbound_token }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="text" name="module_growthcontour_inbound_token" value="{{ module_growthcontour_inbound_token }}" id="input-inbound-token" class="form-control" readonly />
                    <span class="input-group-btn">
                      <button type="button" class="btn btn-default" id="btn-copy-inbound" title="{{ button_copy }}"><i class="fa fa-copy"></i></button>
                      <button type="button" class="btn btn-warning" id="btn-regenerate-inbound" title="{{ button_regenerate }}"><i class="fa fa-refresh"></i></button>
                      <button type="button" class="btn btn-danger" id="btn-revoke-old" title="{{ button_revoke_old }}"><i class="fa fa-ban"></i></button>
                    </span>
                  </div>
                  <p class="help-block">{{ help_inbound_token }}</p>
                  {% if module_growthcontour_inbound_token_old %}
                  <p class="help-block text-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_rotation_active }}</p>
                  {% endif %}
                </div>
              </div>

            </div>

            <!-- Tab: Orders -->
            <div class="tab-pane" id="tab-orders">

              <div id="orders-diag"></div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_send_status }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_orders_status" class="form-control">
                    <option value="1" {{ module_growthcontour_orders_status ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_orders_status ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                  <p class="help-block">{{ help_send_status }}</p>
                </div>
              </div>

              <hr>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_sync_all }}</label>
                <div class="col-sm-10">
                  <button type="button" id="btn-sync-all" class="btn btn-primary"><i class="fa fa-cloud-upload"></i> {{ button_sync_all }}</button>
                  <div id="sync-all-progress" style="margin-top:10px;"></div>
                  <p class="help-block">{{ help_sync_all }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-send-order">{{ entry_send_order }}</label>
                <div class="col-sm-10">
                  <div class="input-group" style="max-width:320px;">
                    <span class="input-group-addon">#</span>
                    <input type="number" min="1" id="input-send-order" class="form-control" placeholder="{{ placeholder_send_order }}" />
                    <span class="input-group-btn">
                      <button type="button" id="btn-send-order" class="btn btn-primary"><i class="fa fa-paper-plane"></i> {{ button_send_order }}</button>
                    </span>
                  </div>
                  <div id="send-order-result" style="margin-top:10px;"></div>
                  <p class="help-block">{{ help_send_order }}</p>
                </div>
              </div>

              <hr>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_status_map }}</label>
                <div class="col-sm-10">
                  <button type="button" id="btn-sync-statuses" class="btn btn-info"><i class="fa fa-refresh"></i> {{ button_sync_statuses }}</button>
                  <span id="sync-result" style="margin-left:8px;"></span>
                  <p class="help-block">{{ help_status_map }}</p>

                  <table class="table table-bordered" style="margin-top:10px;max-width:640px;">
                    <thead>
                      <tr>
                        <th style="width:50%;">{{ column_oc_status }}</th>
                        <th>{{ column_crm_status }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for order_status in order_statuses %}
                      <tr>
                        <td>{{ order_status.name }}</td>
                        <td>
                          <select name="module_growthcontour_status_map[{{ order_status.order_status_id }}]" class="form-control crm-status-select">
                            <option value="">{{ text_none }}</option>
                            {% for crm in module_growthcontour_crm_statuses %}
                            <option value="{{ crm.id }}" {{ (module_growthcontour_status_map[order_status.order_status_id] is defined and module_growthcontour_status_map[order_status.order_status_id] == crm.id) ? 'selected="selected"' }}>{{ crm.name }}</option>
                            {% endfor %}
                          </select>
                        </td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>

                  <div id="crm-status-store" style="display:none;">
                    {% for crm in module_growthcontour_crm_statuses %}
                    <input type="hidden" name="module_growthcontour_crm_statuses[{{ loop.index0 }}][id]" value="{{ crm.id }}" />
                    <input type="hidden" name="module_growthcontour_crm_statuses[{{ loop.index0 }}][name]" value="{{ crm.name }}" />
                    {% endfor %}
                  </div>
                </div>
              </div>

              <hr>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_status_map_in }}</label>
                <div class="col-sm-10">
                  <p class="help-block">{{ help_status_map_in }}</p>
                  <table class="table table-bordered" style="margin-top:10px;max-width:640px;">
                    <thead>
                      <tr>
                        <th style="width:50%;">{{ column_crm_status }}</th>
                        <th>{{ column_oc_status }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for crm in module_growthcontour_crm_statuses %}
                      <tr>
                        <td>{{ crm.name }}</td>
                        <td>
                          <select name="module_growthcontour_status_map_in[{{ crm.id }}]" class="form-control">
                            <option value="">{{ text_none }}</option>
                            {% for order_status in order_statuses %}
                            <option value="{{ order_status.order_status_id }}" {{ (module_growthcontour_status_map_in[crm.id] is defined and module_growthcontour_status_map_in[crm.id] == order_status.order_status_id) ? 'selected="selected"' }}>{{ order_status.name }}</option>
                            {% endfor %}
                          </select>
                        </td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>

              <hr>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_paid_statuses }}</label>
                <div class="col-sm-10">
                  <p class="help-block">{{ help_paid_statuses }}</p>
                  <div style="max-width:640px;">
                    {% for order_status in order_statuses %}
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="module_growthcontour_paid_statuses[]" value="{{ order_status.order_status_id }}" {{ (module_growthcontour_paid_statuses and order_status.order_status_id in module_growthcontour_paid_statuses) ? 'checked="checked"' }} />
                        {{ order_status.name }}
                      </label>
                    </div>
                    {% endfor %}
                  </div>
                </div>
              </div>

            </div>

            <!-- Tab: Abandoned cart -->
            <div class="tab-pane" id="tab-cart">

              <div id="cart-stats" style="margin-bottom:15px;"></div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_cart_enabled }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_cart_enabled" class="form-control">
                    <option value="1" {{ module_growthcontour_cart_enabled ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_cart_enabled ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                  <p class="help-block">{{ help_cart_enabled }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-cart-threshold">{{ entry_cart_threshold }}</label>
                <div class="col-sm-10">
                  <input type="number" min="1" name="module_growthcontour_cart_threshold_min" value="{{ module_growthcontour_cart_threshold_min ?: 60 }}" id="input-cart-threshold" class="form-control" />
                  <p class="help-block">{{ help_cart_threshold }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-cart-maxage">{{ entry_cart_max_age }}</label>
                <div class="col-sm-10">
                  <input type="number" min="1" name="module_growthcontour_cart_max_age_hours" value="{{ module_growthcontour_cart_max_age_hours ?: 168 }}" id="input-cart-maxage" class="form-control" />
                  <p class="help-block">{{ help_cart_max_age }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-cart-minamount">{{ entry_cart_min_amount }}</label>
                <div class="col-sm-10">
                  <input type="number" min="0" step="0.01" name="module_growthcontour_cart_min_amount" value="{{ module_growthcontour_cart_min_amount ?: 0 }}" id="input-cart-minamount" class="form-control" />
                  <p class="help-block">{{ help_cart_min_amount }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-cart-batch">{{ entry_cart_batch }}</label>
                <div class="col-sm-10">
                  <input type="number" min="1" max="200" name="module_growthcontour_cart_batch" value="{{ module_growthcontour_cart_batch ?: 50 }}" id="input-cart-batch" class="form-control" />
                  <p class="help-block">{{ help_cart_batch }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_cart_guests }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_cart_guests" class="form-control">
                    <option value="1" {{ module_growthcontour_cart_guests ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_cart_guests ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                  <p class="help-block">{{ help_cart_guests }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_cart_require_contact }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_cart_require_contact" class="form-control">
                    <option value="1" {{ module_growthcontour_cart_require_contact ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_cart_require_contact ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                  <p class="help-block">{{ help_cart_require_contact }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_cart_require_consent }}</label>
                <div class="col-sm-10">
                  <select name="module_growthcontour_cart_require_consent" class="form-control">
                    <option value="1" {{ module_growthcontour_cart_require_consent ? 'selected="selected"' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not module_growthcontour_cart_require_consent ? 'selected="selected"' }}>{{ text_disabled }}</option>
                  </select>
                  <p class="help-block">{{ help_cart_require_consent }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_cart_cron }}</label>
                <div class="col-sm-10">
                  <input type="text" value="{{ cart_cron_url }}" class="form-control" readonly onclick="this.select();" />
                  <p class="help-block">{{ help_cart_cron }}</p>
                  <pre style="white-space:pre-wrap;">*/10 * * * * curl -s -H "Authorization: Bearer {{ module_growthcontour_inbound_token }}" "{{ cart_cron_url }}"</pre>
                </div>
              </div>

            </div>

            <!-- Tab: Catalog -->
            <div class="tab-pane" id="tab-catalog">

              <div class="catalog-run" style="margin-bottom:12px;">
                <button type="button" class="btn btn-success btn-catalog-run" data-entity="all"><i class="fa fa-refresh"></i> {{ button_sync_catalog_all }}</button>
                <label class="checkbox-inline" style="margin-left:10px;"><input type="checkbox" class="opt-force" /> {{ text_opt_force }}</label>
                <label class="checkbox-inline text-danger"><input type="checkbox" class="opt-wipe" /> {{ text_opt_wipe }}</label>
                <span class="catalog-run-result" style="margin-left:8px;"></span>
              </div>

              <div id="catalog-progress" style="margin-bottom:15px;"></div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_sync_batch }}</label>
                <div class="col-sm-10">
                  <input type="number" min="10" max="500" name="module_growthcontour_sync_batch" value="{{ module_growthcontour_sync_batch }}" class="form-control" style="max-width:160px;" />
                  <p class="help-block">{{ help_sync_batch }}</p>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_sync_cron }}</label>
                <div class="col-sm-10">
                  <pre style="white-space:pre-wrap;margin:0;">*/5 * * * * curl -s -H "Authorization: Bearer {{ module_growthcontour_inbound_token }}" "{{ catalog_cron_url }}"</pre>
                  <p class="help-block">{{ help_sync_cron }}</p>
                </div>
              </div>

              {% set ents = {'categories': tab_cat_categories, 'attributes': tab_cat_attributes, 'products': tab_cat_products, 'reviews': tab_cat_reviews, 'customers': tab_cat_customers} %}
              {% set all_matches = {
                'products': {'sku': text_match_sku, 'id': text_match_id, 'map': text_match_map},
                'categories': {'name': text_match_name, 'id': text_match_id, 'map': text_match_map},
                'attributes': {'name': text_match_name, 'id': text_match_id, 'map': text_match_map},
                'reviews': {'map': text_match_map, 'id': text_match_id},
                'customers': {'email': text_match_email, 'id': text_match_id, 'map': text_match_map}
              } %}

              <ul class="nav nav-pills" style="margin-bottom:20px;">
                {% for e, title in ents %}
                <li{{ loop.first ? ' class="active"' }}><a href="#cat-{{ e }}" data-toggle="tab">{{ title }}</a></li>
                {% endfor %}
              </ul>

              <div class="tab-content">
                {% for e, title in ents %}
                {% set k = 'module_growthcontour_sync_' ~ e %}
                <div class="tab-pane{{ loop.first ? ' active' }}" id="cat-{{ e }}">

                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_enabled }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}" class="form-control">
                        <option value="1" {{ attribute(_context, k) ? 'selected="selected"' }}>{{ text_enabled }}</option>
                        <option value="0" {{ not attribute(_context, k) ? 'selected="selected"' }}>{{ text_disabled }}</option>
                      </select>
                      <p class="help-block">{{ attribute(_context, 'help_sync_' ~ e) }}</p>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_match }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}_match" class="form-control">
                        {% for v, t in all_matches[e] %}
                        <option value="{{ v }}" {{ attribute(_context, k ~ '_match') == v ? 'selected="selected"' }}>{{ t }}</option>
                        {% endfor %}
                      </select>
                      <p class="help-block">{{ help_sync_match }}</p>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_create }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}_create" class="form-control">
                        <option value="1" {{ attribute(_context, k ~ '_create') ? 'selected="selected"' }}>{{ text_enabled }}</option>
                        <option value="0" {{ not attribute(_context, k ~ '_create') ? 'selected="selected"' }}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_update }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}_update" class="form-control">
                        <option value="1" {{ attribute(_context, k ~ '_update') ? 'selected="selected"' }}>{{ text_enabled }}</option>
                        <option value="0" {{ not attribute(_context, k ~ '_update') ? 'selected="selected"' }}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_missing }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}_missing" class="form-control">
                        {% for v in (e == 'products' ? ['disable', 'out_of_stock', 'delete', 'keep'] : ['disable', 'delete', 'keep']) %}
                        <option value="{{ v }}" {{ attribute(_context, k ~ '_missing') == v ? 'selected="selected"' }}>{{ attribute(_context, 'text_missing_' ~ v) }}</option>
                        {% endfor %}
                      </select>
                      <p class="help-block">{{ help_sync_missing }}</p>
                    </div>
                  </div>

                  {% if e == 'products' %}
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_sku }}</label>
                    <div class="col-sm-10">
                      <select name="module_growthcontour_sync_products_sku" class="form-control">
                        <option value="model" {{ module_growthcontour_sync_products_sku == 'model' ? 'selected="selected"' }}>{{ text_sku_model }}</option>
                        <option value="sku" {{ module_growthcontour_sync_products_sku == 'sku' ? 'selected="selected"' }}>{{ text_sku_sku }}</option>
                      </select>
                      <p class="help-block">{{ help_sync_sku }}</p>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_fields }}</label>
                    <div class="col-sm-10">
                      <input type="hidden" name="module_growthcontour_sync_products_fields[]" value="" />
                      {% for f in ['price', 'quantity', 'status', 'content', 'categories', 'options', 'attributes'] %}
                      <div class="checkbox"><label>
                        <input type="checkbox" name="module_growthcontour_sync_products_fields[]" value="{{ f }}" {{ f in module_growthcontour_sync_products_fields ? 'checked="checked"' }} />
                        {{ attribute(_context, 'text_field_' ~ f) }}
                      </label></div>
                      {% endfor %}
                      <p class="help-block">{{ help_sync_fields }}</p>
                    </div>
                  </div>
                  {% endif %}

                  {% if e == 'reviews' %}
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_moderation }}</label>
                    <div class="col-sm-10">
                      <select name="module_growthcontour_sync_reviews_moderation" class="form-control">
                        <option value="1" {{ module_growthcontour_sync_reviews_moderation ? 'selected="selected"' }}>{{ text_enabled }}</option>
                        <option value="0" {{ not module_growthcontour_sync_reviews_moderation ? 'selected="selected"' }}>{{ text_disabled }}</option>
                      </select>
                      <p class="help-block">{{ help_sync_reviews_moderation }}</p>
                    </div>
                  </div>
                  {% endif %}

                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_sync_auto }}</label>
                    <div class="col-sm-10">
                      <select name="{{ k }}_auto" class="form-control">
                        {% for v, t in sync_intervals %}
                        <option value="{{ v }}" {{ attribute(_context, k ~ '_auto') == v ? 'selected="selected"' }}>{{ t }}</option>
                        {% endfor %}
                      </select>
                    </div>
                  </div>

                  <div class="form-group catalog-run">
                    <label class="col-sm-2 control-label">{{ entry_sync_manual }}</label>
                    <div class="col-sm-10">
                      <label class="checkbox-inline"><input type="checkbox" class="opt-force" /> {{ text_opt_force }}</label>
